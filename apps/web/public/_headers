# Cabeceras del frontend (sintaxis estilo Netlify; Render las soporta en sitios
# estáticos. Si tu servicio no las toma, replica estos valores en el dashboard).
#
# NOTA: la CSP va en modo *Report-Only* a propósito: primero observamos sin
# bloquear (Jitsi y Cloudinary requieren permisos concretos).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self "https://meet.jit.si"), microphone=(self "https://meet.jit.si"), geolocation=(self), display-capture=(self "https://meet.jit.si")
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://meet.jit.si https://*.jitsi.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://*.cloudinary.com; media-src 'self' blob: https://res.cloudinary.com https://*.cloudinary.com; connect-src 'self' https: wss:; frame-src https://meet.jit.si; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: public, max-age=0, must-revalidate

# Assets con hash: inmutables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imagen social: cache diaria.
/og-image.png
  Cache-Control: public, max-age=86400

# El manifest debe servirse con su tipo correcto.
/manifest.webmanifest
  Content-Type: application/manifest+json
