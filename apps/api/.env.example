# Entorno: "development" o "production".
# En production se exige un JWT_SECRET fuerte y se deshabilitan /docs y /redoc.
ENVIRONMENT=development
# Confiar en X-Forwarded-For para el rate limiting. Activar SOLO detrás de un proxy.
TRUST_PROXY_HEADERS=false

# Database
DATABASE_URL=postgresql://sabiodoc:sabiodoc_secret@localhost:55432/sabiodoc_db
# BD de test (opcional). Si no se define, los tests usan DATABASE_URL con sufijo _test.
TEST_DATABASE_URL=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Recuperación de contraseña
PASSWORD_RESET_TOKEN_MINUTES=30
# SMTP opcional: sin configurar, en desarrollo el enlace se registra en los logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Exigir verificación de correo al registrarse (paciente y médico).
EMAIL_VERIFICATION_REQUIRED=true
# Vigencia del enlace de verificación (minutos). Por defecto 1440 (24 h).
EMAIL_VERIFICATION_TOKEN_MINUTES=1440

# DeepSeek AI (optional - mock mode if not set)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Groq AI (fallback si DeepSeek falla, no responde o tarda demasiado)
# Pega aquí tu API key de Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Tiempo máximo de espera por proveedor antes de pasar al fallback (segundos)
LLM_TIMEOUT_SECONDS=8

# CORS: en producción, lista de orígenes separados por comas (obligatorio).
# En desarrollo se añaden automáticamente los orígenes locales habituales.
FRONTEND_ORIGIN=http://localhost:9091

# Jitsi (videoconsultas). El frontend integra el API externo (IFrame API)
# cargando `<JITSI_BASE_URL>/external_api.js`. Para el servicio público usa
# JITSI_BASE_URL=https://meet.jit.si y JITSI_DOMAIN=meet.jit.si (salas públicas).
JITSI_BASE_URL=https://meet.jit.si  # https://192.168.1.123:7443
JITSI_DOMAIN=meet.jit.si # 192.168.1.123:7443
JITSI_ROOM_PREFIX=SabioDoc
JITSI_JWT_APP_ID=sabiodoc
JITSI_JWT_AUDIENCE=jitsi
# Secreto JWT compartido con un Jitsi propio/JaaS (dejar vacío en meet.jit.si:
# las salas públicas no usan JWT y el primer participante es moderador).
JITSI_JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
# Deploy hook del frontend (Render) para regenerar el prerender público.
FRONTEND_DEPLOY_HOOK_URL=
# No ejecutar datos demo en producción salvo que se fuerce explícitamente.
ALLOW_SEED_IN_PRODUCTION=false
STRIPE_CURRENCY=usd
# Secret para validar webhooks de Stripe (payouts).
STRIPE_WEBHOOK_SECRET=
# Pasarela de payouts (retiros): "mock" en pruebas, "stripe" en producción.
PAYOUT_PROVIDER=mock

# Video Consultation Rules
VIDEO_PRICE_MIN_CENTS=10
VIDEO_PRICE_MAX_CENTS=30000
VIDEO_MIN_PREPAY_MINUTES=15
VIDEO_PREPARE_EXPIRATION_MINUTES=20

# Borradores de consulta IA: se cierran tras N horas sin actividad (168 = 7 días)
CONSULTATION_DRAFT_TTL_HOURS=168

# Presencia de médicos: minutos de inactividad antes de considerarlos "Desconectado"
DOCTOR_PRESENCE_ONLINE_MINUTES=5

# Registro de errores para el panel de administración (backend + navegador).
# Los registros más antiguos que esta retención se purgan automáticamente.
ERROR_LOG_RETENTION_DAYS=60
# Máximo de caracteres guardados por campo largo (stack trace / contexto JSON).
ERROR_LOG_MAX_TEXT_CHARS=20000

# Tickets de soporte: máximo de adjuntos por mensaje.
SUPPORT_TICKET_MAX_ATTACHMENTS=5

# Créditos (dinero de prueba): 1 crédito = 1 USD = 100 centavos
CREDITS_CURRENCY=usd
WALLET_MIN_TOPUP_CENTS=500
WALLET_MAX_TOPUP_CENTS=100000
WALLET_MIN_WITHDRAWAL_CENTS=1000
# Comision de plataforma sobre cada cita, en puntos basicos (100 = 1%). 2000 = 20%.
PLATFORM_FEE_BPS=2000

# Facturación por tiempo real en videoconsulta
# Segundos sin señal de un participante antes de pausar el cronómetro
VIDEO_PRESENCE_TIMEOUT_SECONDS=30
# Mínimo facturable (minutos) si la sesión estuvo activa
VIDEO_MIN_BILLABLE_MINUTES=1
# Si una sesión activa se queda sin nadie en la sala durante este tiempo, se
# cierra y liquida automáticamente (evita sesiones colgadas y retenciones sin resolver).
VIDEO_SESSION_ABANDON_MINUTES=5

# Archivos compartidos en videoconsultas y fotos de perfil (Cloudinary).
# Deja las credenciales vacías para deshabilitar la carga de archivos y fotos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sabiodoc/session-files
# Carpeta donde se guardan las fotos de perfil de los médicos.
CLOUDINARY_DOCTOR_FOLDER=sabiodoc/doctors
# Tamaño máximo de la foto de perfil (MB).
DOCTOR_PHOTO_MAX_MB=5
# Máximo de archivos que cada participante puede enviar por sesión.
SESSION_FILES_MAX=10
# Tamaño máximo por archivo (MB).
SESSION_FILE_MAX_MB=20
